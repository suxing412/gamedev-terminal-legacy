{
  "name": "gamedev-terminal",
  "version": "0.12.0",
  "private": true,
  "description": "游戏开发者终端 · 全屏常驻坐席",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "app": "electron .",
    "dist": "npm run build:web && electron-builder --win portable",
    "test": "node --test \"test/*.test.js\"",
    "test:one": "node --test",
    "build:web": "node scripts/构建.js",
    "壳内": "electron test/壳内/跑道.js",
    "镜像": "node scripts/镜像.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "diff": "^5.2.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "local.gamedev.terminal",
    "productName": "游戏开发者终端",
    "directories": {
      "output": "D:/terminal-build/dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "server/**",
      "intel/**",
      "config/**",
      "public/**",
      "监视器/**",
      "node_modules/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
